[Unit]
Description=One exact pending Human proposal endorsed by the existing Release root
After=local-fs.target
ConditionPathExists=/etc/minimal-human-trust/human-proposal-request.json
ConditionPathExists=/etc/minimal-human-trust/first-trust-code.json
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/node /usr/lib/minimal-human-trust/release/human-proposal-bootstrap.mjs
LoadCredentialEncrypted=release-signing-key:/etc/credstore.encrypted/r16-release/release-signing-key.cred
StateDirectory=minimal-human-trust/human-proposals/enroll_human minimal-human-trust/human-proposals/first_cutover_handoff
StateDirectoryMode=0700
UMask=0077
Restart=no
RemainAfterExit=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/minimal-human-trust /var/lib/minimal-human-trust/human-proposals
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
LimitCORE=0
MemoryMax=256M
TasksMax=12
TimeoutStartSec=75
TimeoutStopSec=10
SendSIGKILL=no
StandardInput=null
StandardOutput=journal
StandardError=null
