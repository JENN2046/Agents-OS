[Unit]
Description=Minimal Human Trust privileged Human approval socket

[Socket]
ListenStream=/run/minimal-human-trust/human.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
Accept=yes
MaxConnections=8
MaxConnectionsPerSource=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
