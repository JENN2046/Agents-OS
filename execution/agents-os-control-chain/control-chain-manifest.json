{
  "schema_version": "agents-os.control-chain.manifest.v0.1",
  "component_id": "agents-os-control-chain-v0.1",
  "role": "commander-first dual-track control chain",
  "default_mode": "preview_first_no_provider",
  "tracks": [
    "colameta",
    "local_executor"
  ],
  "authorization_model": {
    "commander_is_only_authorization_source": true,
    "track_selector_can_elevate": false,
    "colameta_real_execution_authorized": false,
    "provider_backed_execution_authorized": false,
    "queue_mutation_default": "proposal_only",
    "reviewed_queue_mutation_requires_accepted_nobao_review": true,
    "route_auto_selection_authorized": false,
    "route_choice_queue_proposal_default": "preview_only",
    "reviewed_route_adoption_default": "preview_only_no_apply",
    "reviewed_route_adoption_apply_requires_explicit_apply_flag": true,
    "auto_promote_authorized": false
  },
  "failure_handling": {
    "failure_categories": [
      "validation_failed",
      "scope_violation",
      "protected_path_detected",
      "dirty_worktree_conflict",
      "unknown_action_type",
      "p3_signal_detected",
      "executor_output_invalid"
    ],
    "queue_promotion_on_failure": false,
    "silent_retry_authorized": false,
    "destructive_cleanup_authorized": false,
    "provider_call_authorized": false,
    "external_write_authorized": false,
    "max_green_repair_attempts": 1,
    "repair_attempts_performed_in_v0_1": 0,
    "requires_nobao_review": true
  },
  "execution_authorization_scopes": [
    "none",
    "local_safe_only",
    "blocked_requires_jenn"
  ],
  "local_safe_actions": [
    "write_governance_doc",
    "write_receipt_review_report",
    "update_current_state",
    "run_validation_command"
  ],
  "forbidden_actions": [
    "route_adoption",
    "workspace_route_state_write",
    "route_auto_selection",
    "queue_write",
    "queue_promotion",
    "update_active_queue",
    "provider_call",
    "service_start",
    "runtime_plugin_activation",
    "external_write",
    "formal_memory_write",
    "state_private_read",
    "auth_provider_runtime_config_change",
    "destructive_git_or_filesystem_operation"
  ],
  "commands": [
    "PYTHONDONTWRITEBYTECODE=1 python3 execution/agents-os-control-chain/control_chain.py validate",
    "PYTHONDONTWRITEBYTECODE=1 python3 execution/agents-os-control-chain/control_chain.py route-choice-queue-proposal --route-choice-preview-json /path/to/route-choice-preview.json --json",
    "PYTHONDONTWRITEBYTECODE=1 python3 execution/agents-os-control-chain/control_chain.py reviewed-route-adoption-preview --proposal-json /path/to/proposal.json --review-json /path/to/review.json --queue control-plane/registry/reports/2026-07-07-agents-os-active-work-queue-v0.1.md --json",
    "PYTHONDONTWRITEBYTECODE=1 python3 execution/agents-os-control-chain/control_chain.py reviewed-route-adoption-apply-gate --proposal-json /path/to/proposal.json --review-json /path/to/review.json --queue /path/to/queue.md --json",
    "PYTHONDONTWRITEBYTECODE=1 python3 execution/agents-os-control-chain/test-control-chain.py"
  ]
}
