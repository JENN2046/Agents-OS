{
  "name": "agents-os-resident",
  "version": "0.3.0-local-owner.0",
  "private": true,
  "description": "VCP-owned local companion for the consent-gated AGENTS OS Goal/Task profile",
  "main": "index.js",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "build:debug": "napi build --platform --no-js --dts target/native-binding.d.ts",
    "build:release": "napi build --platform --release --no-js --dts target/native-binding.d.ts",
    "build:integrity": "node tools/build-companion-integrity.mjs --output companion-integrity.json",
    "build:companion": "npm run build:release && npm run build:peer-credentials && npm run build:integrity",
    "check:r2-prerequisites": "node tools/check-r2-validation-prerequisites.mjs --check",
    "legacy:build:offline": "node tools/build-offline-package.mjs --stage wp4",
    "check:host-behavior": "node --test tests/host-behavior-contract.test.cjs tests/host-loop.test.cjs",
    "legacy:check:sealed-host": "node tools/validate-sealed-host-contract.mjs --stage wp0",
    "legacy:preview:compatibility": "node tools/validate-sealed-host-contract.mjs --compatibility-preview",
    "preview:companion-projection": "node tools/validate-companion-projection.mjs --check",
    "prepare:protected-roots": "node companion/resident-daemon.js --operation prepare-roots",
    "provision:witness": "node companion/resident-daemon.js --operation provision",
    "test": "node --test tests/activation-lifecycle.test.cjs tests/cognitive-context.test.cjs tests/companion-adapter.test.cjs tests/companion-protocol.test.cjs tests/companion-server.test.cjs tests/daemon-peer-auth.test.cjs tests/daemon-provisioning.test.cjs tests/discovery-bootstrap.test.cjs tests/fresh-presence-operational.test.cjs tests/host-behavior-contract.test.cjs tests/host-loop.test.cjs tests/local-owner-boundary.test.cjs tests/memory-body-writer.test.cjs tests/memory-publication.test.cjs tests/memory-publication-host.test.cjs tests/p6b-companion-integration.test.cjs tests/p6c-negative-control.test.cjs tests/p6d-candidate-guard.test.cjs tests/plugin-manager-frozen-result.test.cjs tests/pr41-r2-adversarial.test.cjs tests/pr41-second-review-repair.test.cjs tests/presence-companion-integration.test.cjs tests/presence-context.test.cjs tests/provider-attempt-hook.test.cjs tests/sealed-host-companion-contract.test.mjs tests/systemd-renderer.test.mjs tests/vcpchat-presentation.test.cjs tests/windows-target-quarantine-integration.test.cjs",
    "test:daemon-peer-auth": "node --test tests/daemon-peer-auth.test.cjs",
    "test:activation": "node --test tests/activation-lifecycle.test.cjs",
    "test:companion-integration": "node --test tests/companion-integration.test.cjs",
    "test:daemon-provisioning": "node --test tests/daemon-provisioning.test.cjs",
    "test:memory-body-writer": "node --test tests/memory-body-writer.test.cjs",
    "test:p6b-companion-integration": "node --test tests/p6b-companion-integration.test.cjs",
    "test:p6c-negative-control": "node --test tests/p6c-negative-control.test.cjs",
    "test:p6d-candidate-guard": "node --test tests/p6d-candidate-guard.test.cjs",
    "test:presence": "node --test tests/presence-context.test.cjs tests/presence-companion-integration.test.cjs",
    "test:fresh-presence": "node --test tests/fresh-presence-operational.test.cjs",
    "test:provider-boundary": "node --test tests/provider-attempt-hook.test.cjs",
    "test:r2-adversarial": "node --test tests/pr41-r2-adversarial.test.cjs tests/cognitive-context.test.cjs tests/companion-protocol.test.cjs tests/companion-server.test.cjs",
    "validate:p6d-cav4": "node tools/validate-p6d-cav4.mjs",
    "validate:pr41-r2-candidate": "node tools/validate-pr41-r2-candidate.mjs",
    "validate:pr41-second-review-candidate": "node tools/validate-pr41-second-review-candidate.mjs",
    "test:companion-stability": "AGENTS_OS_RESIDENT_STABILITY_MS=60000 node --test tests/companion-integration.test.cjs",
    "verify:host-presentation-binding": "node tools/verify-host-presentation-binding.mjs --check",
    "legacy:test:offline-packaging": "node tests/offline-packaging.mjs",
    "verify:systemd-template": "node tools/render-systemd-unit.mjs --check",
    "legacy:verify:offline-witness": "node tools/build-offline-package.mjs --integrated-witness",
    "build:peer-credentials": "cargo build --locked --offline --release --bin resident-peer-credentials && node tools/stage-peer-credentials.mjs",
    "test:memory-publication": "node --test tests/memory-publication.test.cjs tests/memory-publication-host.test.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3"
  },
  "napi": {
    "binaryName": "agents-os-resident",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  }
}
