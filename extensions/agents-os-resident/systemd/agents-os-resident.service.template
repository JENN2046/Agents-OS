[Unit]
Description=AGENTS OS Resident companion
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@@PLUGIN_ROOT@@
ExecStart=@@NODE_BINARY@@ @@PLUGIN_ROOT@@/companion/resident-daemon.js --root @@ACTIVATION_ROOT@@ --socket %t/agents-os-resident/control.sock --expected-build-id @@BUILD_ID@@ --continuity-evidence '@@CONTINUITY_EVIDENCE_JSON@@' --genesis-provisioning-authority '@@GENESIS_PROVISIONING_AUTHORITY_JSON@@'
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=64 73
TimeoutStopSec=20
KillSignal=SIGTERM
RuntimeDirectory=agents-os-resident
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=@@PLUGIN_ROOT@@
ReadWritePaths=@@ACTIVATION_ROOT@@
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
