admission_order:
  - verify every frozen_authority path is a regular no-follow file with its exact SHA-256
  - verify the runner's closed review-record inventory and exact static execution binding
  - verify the canonical root, .git directory and object directory have the exact required safe shape
  - verify the sealed commit and sealed tree are available before any allowed blob read
  - verify the temporary run root and sole receipt target are absent before creating anything
  - create only the owned temporary run root, ownership marker and temporary result
  - execute exactly the 24 runner-owned Git object commands under the internal fixed environment
  - read content only for the seven sealed allowlisted tuple paths; never read a protected path or protected blob content
  - clean the owned temporary root, observe zero residue, then write exactly one receipt or fail closed

success_observation:
  result: OBJECT_ONLY_SOURCE_RUN_EVIDENCE_CANDIDATE_ONLY
  cleanup_status: CLEAN
  worktree_created: false
  Host_operation_count: 0
  runtime_or_effect_operation_count: 0
  payload_materialized: false
  plugin_enabled_or_loaded: false

failure_contract:
  missing_or_mismatched_input: BLOCKED
  unexpected_root_or_receipt_preexistence: BLOCKED
  canonical_root_or_git_shape_mismatch: BLOCKED
  tuple_or_digest_mismatch: BLOCKED
  protected_path_or_content_read_attempt: BLOCKED
  pending_SIGINT_SIGTERM_or_SIGHUP: BLOCKED_INTERRUPTED_OR_SIGNALLED
  cleanup_or_residue_uncertain: BLOCKED_CLEANUP_OR_RESIDUE_UNVERIFIED
  success_receipt_without_clean_terminal_state: forbidden

never_authorized_by_this_preflight_draft:
  - executing the future invocation
  - VCPToolBox worktree checkout sparse_checkout archive or source modification
  - plugin discovery loading initialize shutdown processToolCall native_or_N_API
  - runtime service database provider authentication private_Memory state_private sensing recording or real effect
  - commit push PR merge tag release deploy publish or history rewrite

