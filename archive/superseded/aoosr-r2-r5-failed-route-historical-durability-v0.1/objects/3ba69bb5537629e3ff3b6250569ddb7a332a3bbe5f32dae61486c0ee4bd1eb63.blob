class Blocked(RuntimeError):
    def __init__(self, result: str, phase: str) -> None:
        super().__init__(result)
        self.result = result
        self.phase = phase


class InterruptedRun(Blocked):
    pass


@dataclass
class RunState:
    command_ids: list[str] = field(default_factory=list)
    root_created: bool = False
    marker_created: bool = False
    temporary_result_created: bool = False
    protected_name_count: int = 0
    allowlisted_blob_content_reads: int = 0
    result: str = "BLOCKED_INTERNAL_UNINITIALIZED"
    failure_phase: str | None = "preflight"
    cleanup_status: str = "NOT_STARTED"


def git_environment() -> dict[str, str]:
    """The exact empty-environment envelope used only by --actual."""

    return {
        "PATH": "/usr/bin:/bin",
        "HOME": "/nonexistent",
        "LC_ALL": "C",
        "GIT_DIR": str(GIT_DIR),
        "GIT_OBJECT_DIRECTORY": str(OBJECT_DIRECTORY),
        "GIT_ALTERNATE_OBJECT_DIRECTORIES": "",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_OPTIONAL_LOCKS": "0",
        "GIT_PAGER": "cat",
    }


def _lstat(path: Path) -> os.stat_result:
    try:
        return os.lstat(path)
    except OSError as exc:
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", "path_lstat") from exc


def _require_directory_not_symlink(path: Path, phase: str) -> None:
    item = _lstat(path)
    if stat.S_ISLNK(item.st_mode) or not stat.S_ISDIR(item.st_mode):
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", phase)


def _require_absent_not_symlink(path: Path, phase: str) -> None:
    try:
        item = os.lstat(path)
    except FileNotFoundError:
        return
    except OSError as exc:
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", phase) from exc
    # Any pre-existing node, including a non-symlink regular file or directory,
    # means exclusive ownership cannot be proven.
    del item
    raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", phase)


def _require_receipt_parent_chain() -> None:
    current = WORKSPACE_ROOT
    _require_directory_not_symlink(current, "workspace_root")
    if current.resolve(strict=True) != current:
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", "workspace_root_realpath")
    for part in RECEIPT_TARGET.relative_to(WORKSPACE_ROOT).parent.parts:
        current = current / part
        _require_directory_not_symlink(current, "receipt_parent")


def _reject_duplicate_json_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def _valid_lower_sha256(value: Any) -> bool:
    return type(value) is str and len(value) == 64 and all(character in "0123456789abcdef" for character in value)


def _safe_workspace_relative_path(value: Any) -> str:
    if type(value) is not str or not value or "\\" in value:
        raise ValueError("unsafe workspace path")
    item = PurePosixPath(value)
    if item.is_absolute() or any(part in {"", ".", ".."} for part in item.parts):
        raise ValueError("unsafe workspace path")
    if any(part in PROTECTED_WORKSPACE_COMPONENTS for part in item.parts):
        raise ValueError("unsafe workspace path")
    basename = item.parts[-1]
    if basename == ".env" or basename.startswith(".env.") or basename == "config.env":
        raise ValueError("unsafe workspace path")
    return item.as_posix()


def _require_regular_workspace_file(relative: str, phase: str) -> Path:
    try:
        candidate = WORKSPACE_ROOT.joinpath(*PurePosixPath(_safe_workspace_relative_path(relative)).parts)
    except ValueError as exc:
        raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", phase) from exc
    try:
        direct = os.lstat(candidate)
        resolved = candidate.resolve(strict=True)
    except OSError as exc:
        raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", phase) from exc
    if stat.S_ISLNK(direct.st_mode) or not stat.S_ISREG(direct.st_mode):
        raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", phase)
    if WORKSPACE_ROOT.resolve(strict=True) != WORKSPACE_ROOT or resolved != candidate:
        raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", phase)
    return candidate


def _read_regular_workspace_file(relative: str, phase: str) -> bytes:
    candidate = _require_regular_workspace_file(relative, phase)
    try:
        descriptor = os.open(candidate, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as exc:
        raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", phase) from exc
    try:
        item = os.fstat(descriptor)
        if not stat.S_ISREG(item.st_mode):
            raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", phase)
        pieces: list[bytes] = []
        while True:
            piece = os.read(descriptor, 65536)
            if not piece:
                break
            pieces.append(piece)
        return b"".join(pieces)
    except OSError as exc:
        raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", phase) from exc
    finally:
        os.close(descriptor)


def _validate_review_manifest_document(document: Any) -> tuple[tuple[dict[str, str], ...], str]:
    if type(document) is not dict or set(document) != {
        "schema_version", "review_unit", "atomic", "partial_review",
        "subjects", "authority_inputs", "author_evidence", "fixed_commands",
    }:
        raise ValueError("review manifest keys")
    if (
        document["schema_version"] != "agents-os.hash-bound-independent-review-package.v0.1"
        or document["review_unit"] != REVIEW_UNIT
        or document["atomic"] is not True
        or document["partial_review"] != "forbidden"
    ):
        raise ValueError("review manifest shape")
    fixed_commands = document["fixed_commands"]
    if type(fixed_commands) is not list or len(fixed_commands) != 7 or any(type(item) is not str or not item for item in fixed_commands):
        raise ValueError("review manifest commands")
    records: list[dict[str, str]] = []
    decision_digest: str | None = None
    for group, expected in EXPECTED_REVIEW_RECORDS.items():
        entries = document[group]
        if type(entries) is not list or len(entries) != len(expected):
            raise ValueError("review manifest record count")
        for entry, (expected_id, expected_path) in zip(entries, expected, strict=True):
            if type(entry) is not dict or set(entry) != {"id", "path", "sha256"}:
                raise ValueError("review manifest record keys")
            if (
                entry["id"] != expected_id
                or entry["path"] != expected_path
                or not _valid_lower_sha256(entry["sha256"])
            ):
                raise ValueError("review manifest record value")
            records.append(entry)
            if entry["id"] == "R2_successor_decision_package":
                decision_digest = entry["sha256"]
    if len(records) != EXPECTED_REVIEW_RECORD_COUNT or len({entry["path"] for entry in records}) != len(records):
        raise ValueError("review manifest record uniqueness")
    if decision_digest is None:
        raise ValueError("review manifest decision package")
    return tuple(records), decision_digest


def _verify_bound_manifest() -> str:
    """Verify the current reviewed R2 bytes before any Git command is possible."""

    manifest_relative = str(REVIEW_MANIFEST_PATH.relative_to(WORKSPACE_ROOT))
    try:
        manifest_bytes = _read_regular_workspace_file(manifest_relative, "review_manifest")
        document = json.loads(manifest_bytes.decode("utf-8"), object_pairs_hook=_reject_duplicate_json_keys)
        records, decision_digest = _validate_review_manifest_document(document)
    except (Blocked, OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
        raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", "review_manifest_parse") from exc
    for entry in records:
        if sha256(_read_regular_workspace_file(entry["path"], "review_manifest_subject")).hexdigest() != entry["sha256"]:
            raise Blocked("BLOCKED_REVIEW_BINDING_MISMATCH", "review_manifest_hash")
    return decision_digest


def _assert_preconditions() -> None:
    if Path.cwd().resolve() != WORKSPACE_ROOT:
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", "working_directory")
    _require_directory_not_symlink(CANONICAL_ROOT, "canonical_root")
    if CANONICAL_ROOT.resolve() != CANONICAL_ROOT:
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", "canonical_root_realpath")
    _require_directory_not_symlink(GIT_DIR, "git_directory")
    _require_directory_not_symlink(OBJECT_DIRECTORY, "object_directory")
    info = OBJECT_DIRECTORY / "info"
    if info.exists():
        _require_directory_not_symlink(info, "object_info_directory")
    _require_absent_not_symlink(OBJECT_DIRECTORY / "info" / "alternates", "alternates")
    _require_directory_not_symlink(RUN_ROOT.parent, "temporary_parent")
    _require_absent_not_symlink(RUN_ROOT, "run_root")
    _require_receipt_parent_chain()
    _require_absent_not_symlink(RECEIPT_TARGET, "receipt_target")
    if not hasattr(os, "O_NOFOLLOW"):
        raise Blocked("BLOCKED_LOCAL_TOOLING_UNAVAILABLE", "o_nofollow")
    if not hasattr(signal, "pthread_sigmask"):
        raise Blocked("BLOCKED_SIGNAL_FINALIZER_UNAVAILABLE", "signal_mask")


def _open_exclusive_nofollow(path: Path, content: bytes, phase: str) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags, 0o600)
    except OSError as exc:
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", phase) from exc
    try:
        position = 0
        while position < len(content):
            written = os.write(descriptor, content[position:])
            if written <= 0:
                raise Blocked("BLOCKED_RECEIPT_WRITE_UNVERIFIED", phase)
            position += written
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _create_owned_run_root(state: RunState) -> None:
    try:
        os.mkdir(RUN_ROOT, 0o700)
    except OSError as exc:
        raise Blocked("BLOCKED_PREEXISTING_OR_UNOWNED_PATH", "run_root_create") from exc
    state.root_created = True
    _open_exclusive_nofollow(OWNERSHIP_MARKER, MARKER_BYTES, "ownership_marker_create")
    state.marker_created = True
    _open_exclusive_nofollow(TEMPORARY_RESULT, TEMPORARY_RESULT_BYTES, "temporary_result_create")
    state.temporary_result_created = True


def _require_exact_marker() -> None:
    flags = os.O_RDONLY | os.O_NOFOLLOW
    try:
        descriptor = os.open(OWNERSHIP_MARKER, flags)
    except OSError as exc:
        raise Blocked("BLOCKED_CLEANUP_OR_RESIDUE_UNVERIFIED", "ownership_marker_read") from exc
    try:
        value = os.read(descriptor, len(MARKER_BYTES) + 1)
    finally:
        os.close(descriptor)
    if value != MARKER_BYTES:
        raise Blocked("BLOCKED_CLEANUP_OR_RESIDUE_UNVERIFIED", "ownership_marker_mismatch")


def _finalize_owned_root(state: RunState) -> str:
    if not state.root_created:
        return "NOT_CREATED"
    try:
        _require_exact_marker()
        temporary = _lstat(TEMPORARY_RESULT)
        if stat.S_ISLNK(temporary.st_mode) or not stat.S_ISREG(temporary.st_mode):
            raise Blocked("BLOCKED_CLEANUP_OR_RESIDUE_UNVERIFIED", "temporary_result_shape")
        os.unlink(TEMPORARY_RESULT)
        os.unlink(OWNERSHIP_MARKER)
        os.rmdir(RUN_ROOT)
        try:
            os.lstat(RUN_ROOT)
        except FileNotFoundError:
            return "CLEAN"
        raise Blocked("BLOCKED_CLEANUP_OR_RESIDUE_UNVERIFIED", "residue_present")
    except (Blocked, OSError):
        return "RESIDUE_UNVERIFIED"


def _git_scalar(state: RunState, command_id: str, arguments: list[str], phase: str) -> str:
    try:
        completed = subprocess.run(
            ["git", f"--git-dir={GIT_DIR}", *arguments],
            cwd=WORKSPACE_ROOT,
            env=git_environment(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError as exc:
        raise Blocked("BLOCKED_LOCAL_TOOLING_UNAVAILABLE", phase) from exc
    state.command_ids.append(command_id)
    if completed.returncode != 0:
        raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", phase)
    try:
        value = completed.stdout.decode("ascii", "strict").strip()
    except UnicodeDecodeError as exc:
        raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", phase) from exc
    return value


def _git_name_stream(state: RunState) -> bytes:
    try:
        completed = subprocess.run(
            ["git", f"--git-dir={GIT_DIR}", "ls-tree", "-r", "--name-only", "-z", SEALED_COMMIT, "--"],
            cwd=WORKSPACE_ROOT,
            env=git_environment(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError as exc:
        raise Blocked("BLOCKED_LOCAL_TOOLING_UNAVAILABLE", "name_only_scan") from exc
    state.command_ids.append("G03_NAME_ONLY_SCAN")
    if completed.returncode != 0:
        raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", "name_only_scan")
    return completed.stdout


def _git_digest(state: RunState, item: TupleSpec) -> str:
    try:
        source = subprocess.Popen(
            ["git", f"--git-dir={GIT_DIR}", "cat-file", "blob", item.blob_oid],
            cwd=WORKSPACE_ROOT,
            env=git_environment(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        raise Blocked("BLOCKED_LOCAL_TOOLING_UNAVAILABLE", f"{item.identifier}_digest") from exc
    assert source.stdout is not None
    try:
        digest = sha256()
        while True:
            chunk = source.stdout.read(65536)
            if not chunk:
                break
            digest.update(chunk)
    finally:
        source.stdout.close()
    source_returncode = source.wait()
    state.command_ids.append(f"{item.identifier}_DIGEST")
    if source_returncode != 0:
        raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", f"{item.identifier}_digest")
    return digest.hexdigest()


def _run_exact_git_inventory(state: RunState) -> None:
    value = _git_scalar(state, "G01_COMMIT_EXISTS", ["cat-file", "-e", f"{SEALED_COMMIT}^{{commit}}"], "commit_exists")
    if value:
        raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", "commit_exists_output")
    tree = _git_scalar(state, "G02_TREE_RESOLVE", ["rev-parse", f"{SEALED_COMMIT}^{{tree}}"], "tree_resolve")
    if tree != SEALED_TREE:
        raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", "tree_resolve")
    try:
        scan_result = scan_name_only_stream(_git_name_stream(state))
    except ScannerBlocked as exc:
        raise Blocked("BLOCKED_PROTECTED_PATH_INVENTORY_MISMATCH", "name_only_scan") from exc
    state.protected_name_count = scan_result.protected_name_count
    for item in TUPLES:
        resolved = _git_scalar(
            state,
            f"{item.identifier}_RESOLVE",
            ["rev-parse", f"{SEALED_COMMIT}:{item.path}"],
            f"{item.identifier}_resolve",
        )
        if resolved != item.blob_oid:
            raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", f"{item.identifier}_resolve")
        object_type = _git_scalar(
            state,
            f"{item.identifier}_TYPE",
            ["cat-file", "-t", item.blob_oid],
            f"{item.identifier}_type",
        )
        if object_type != "blob":
            raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", f"{item.identifier}_type")
        if _git_digest(state, item) != item.sha256:
            raise Blocked("BLOCKED_SEALED_SOURCE_OR_TUPLE_MISMATCH", f"{item.identifier}_digest")
        state.allowlisted_blob_content_reads += 1
    if tuple(state.command_ids) != EXPECTED_COMMAND_IDS:
        raise Blocked("BLOCKED_UNAUTHORIZED_OR_NONHERMETIC_GIT_OPERATION", "command_inventory")


def _receipt_bytes(state: RunState, package_sha256: str) -> bytes:
    values: dict[str, Any] = {
        "schema_version": "agents-os.phase5d.actual-object-only-source-run-receipt.v0.1",
        "run_id": RUN_ID,
        "package_sha256": package_sha256,
        "sealed_commit": SEALED_COMMIT,
        "sealed_tree": SEALED_TREE,
        "tuple_set_preimage_sha256": TUPLE_SET_PREIMAGE_SHA256,
        "tuple_count": len(TUPLES),
        "protected_name_inventory_preimage_sha256": EXPECTED_PROTECTED_INVENTORY_SHA256,
        "protected_name_count": state.protected_name_count,
        "protected_blob_content_reads": 0,
        "allowlisted_blob_content_reads": state.allowlisted_blob_content_reads,
        "Git_command_count": len(state.command_ids),
        "Host_operation_count": 0,
        "worktree_created": False,
        "payload_files_created": 0,
        "stdout_bytes_emitted": 0,
        "stderr_bytes_emitted": 0,
        "cleanup_status": state.cleanup_status,
        "result": state.result,
        "failure_phase": state.failure_phase,
    }
    if tuple(values) != RECEIPT_FIELDS:
        raise Blocked("BLOCKED_RECEIPT_WRITE_UNVERIFIED", "receipt_schema")
    return json.dumps(values, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"


class SignalGuard:
    def __init__(self) -> None:
        self.previous: dict[int, Any] = {}
        self.previous_mask: set[int] | None = None

    def __enter__(self) -> "SignalGuard":
        # Block first, then install handlers, then restore the pre-existing mask.
        # This leaves no setup interval in which an owned root can exist while a
        # catchable signal has its prior handler but is not masked.
        self.previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, set(CATCHABLE_SIGNALS))
        try:
            for number in CATCHABLE_SIGNALS:
                self.previous[number] = signal.getsignal(number)
                signal.signal(number, self._handler)
        except Exception:
            signal.pthread_sigmask(signal.SIG_SETMASK, self.previous_mask)
            raise
        signal.pthread_sigmask(signal.SIG_SETMASK, self.previous_mask)
        return self

    def _handler(self, number: int, _frame: Any) -> None:
        raise InterruptedRun("BLOCKED_INTERRUPTED_OR_SIGNALLED", f"signal_{number}")

    def block_for_finalizer(self) -> None:
        signal.pthread_sigmask(signal.SIG_BLOCK, set(CATCHABLE_SIGNALS))

    def __exit__(self, _type: Any, _value: Any, _traceback: Any) -> None:
        for number, previous in self.previous.items():
            signal.signal(number, previous)
        if self.previous_mask is not None:
            signal.pthread_sigmask(signal.SIG_SETMASK, self.previous_mask)


def run_actual() -> int:
    """Run the exact inventory only when a later human decision authorizes it."""

    state = RunState()
    package_sha256 = "UNAVAILABLE"
    with SignalGuard() as guard:
        try:
            package_sha256 = _verify_bound_manifest()
            _assert_preconditions()
            _create_owned_run_root(state)
            _run_exact_git_inventory(state)
            state.result = "OBJECT_ONLY_SOURCE_RUN_EVIDENCE_CANDIDATE_ONLY"
            state.failure_phase = None
        except Blocked as exc:
            state.result = exc.result
            state.failure_phase = exc.phase
        except Exception:
            state.result = "BLOCKED_UNEXPECTED_RUNNER_FAILURE"
            state.failure_phase = "runner"
        finally:
            try:
                guard.block_for_finalizer()
            except OSError:
                state.result = "BLOCKED_SIGNAL_FINALIZER_UNAVAILABLE"
                state.failure_phase = "signal_mask"
            state.cleanup_status = _finalize_owned_root(state)
            if state.cleanup_status not in {"CLEAN", "NOT_CREATED"}:
                state.result = "BLOCKED_CLEANUP_OR_RESIDUE_UNVERIFIED"
                state.failure_phase = "finalizer"
            try:
                _write_actual_receipt(state, package_sha256)
            except Exception:
                state.result = "BLOCKED_RECEIPT_WRITE_UNVERIFIED"
                state.failure_phase = "receipt_write"
    return 0 if state.result == "OBJECT_ONLY_SOURCE_RUN_EVIDENCE_CANDIDATE_ONLY" else 1


def _write_actual_receipt(state: RunState, package_sha256: str) -> None:
    _require_receipt_parent_chain()
    _require_absent_not_symlink(RECEIPT_TARGET, "receipt_target_write")
    _open_exclusive_nofollow(RECEIPT_TARGET, _receipt_bytes(state, package_sha256), "receipt_target_write")


