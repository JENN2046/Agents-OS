            "Git_command_count": 24,
            "protected_blob_content_reads": 0,
            "allowlisted_blob_content_reads": 7,
            "stdout_bytes_emitted": 0,
            "stderr_bytes_emitted": 0,
            "cleanup_status": "CLEAN",
            "Host_operation_count": 0,
            "worktree_created": False,
            "payload_files_created": 0,
        },
    }


def validate_synthetic_fixture(doc: Any) -> list[str]:
    errors: list[str] = []
    if type(doc) is not dict:
        return ["fixture:TYPE"]
    expected_keys = {
        "schema_version", "run_id", "environment", "sealed_host",
        "review_binding",
        "tuple_set_preimage_sha256", "protected_name_inventory_preimage_sha256",
        "command_ids", "path_safety", "finalizer", "expected_success",
    }
    if set(doc) != expected_keys:
        return ["fixture:KEYS"]
    if doc["schema_version"] != "agents-os.phase5d.actual-object-only-source-run-r2.synthetic-fixture.v0.1":
        errors.append("fixture:SCHEMA")
    if doc["run_id"] != RUN_ID:
        errors.append("fixture:RUN_ID")
    if doc["environment"] != git_environment():
        errors.append("fixture:ENVIRONMENT")
    expected_review_binding = {
        "manifest_path": str(REVIEW_MANIFEST_PATH),
        "review_unit": REVIEW_UNIT,
        "record_count": EXPECTED_REVIEW_RECORD_COUNT,
        "fixed_command_count": 7,
        "manifest_verified_before_git": True,
        "duplicate_json_keys_rejected": True,
        "protected_workspace_inputs_rejected": True,
    }
    if doc["review_binding"] != expected_review_binding:
        errors.append("fixture:REVIEW_BINDING")
    if doc["sealed_host"] != {"canonical_root": str(CANONICAL_ROOT), "commit": SEALED_COMMIT, "tree": SEALED_TREE}:
        errors.append("fixture:SEALED_HOST")
    if doc["tuple_set_preimage_sha256"] != TUPLE_SET_PREIMAGE_SHA256:
        errors.append("fixture:TUPLE_PREIMAGE")
    if doc["protected_name_inventory_preimage_sha256"] != EXPECTED_PROTECTED_INVENTORY_SHA256:
        errors.append("fixture:PROTECTED_PREIMAGE")
    if doc["command_ids"] != list(EXPECTED_COMMAND_IDS):
        errors.append("fixture:COMMAND_IDS")
    expected_path_safety = {
        "canonical_root_rejects_symlink": True,
        "canonical_root_realpath_exact": True,
        "receipt_open_flags": ["O_WRONLY", "O_CREAT", "O_EXCL", "O_NOFOLLOW"],
        "temporary_result_created_after_marker": True,
        "temporary_result_open_flags": ["O_WRONLY", "O_CREAT", "O_EXCL", "O_NOFOLLOW"],
    }
    if doc["path_safety"] != expected_path_safety:
        errors.append("fixture:PATH_SAFETY")
    expected_finalizer = {
        "catchable_signals": ["SIGINT", "SIGTERM", "SIGHUP"],
        "signals_blocked_before_handler_installation": True,
        "signal_finalizer_masked": True,
        "unrecoverable_SIGKILL_result": "BLOCKED_UNRECOVERED_INTERRUPTION",
        "uses_recursive_delete": False,
        "uses_rmdir_only": True,
    }
    if doc["finalizer"] != expected_finalizer:
        errors.append("fixture:FINALIZER")
    expected_success = {
        "result": "OBJECT_ONLY_SOURCE_RUN_EVIDENCE_CANDIDATE_ONLY",
        "Git_command_count": 24,
        "protected_blob_content_reads": 0,
        "allowlisted_blob_content_reads": 7,
        "stdout_bytes_emitted": 0,
        "stderr_bytes_emitted": 0,
        "cleanup_status": "CLEAN",
        "Host_operation_count": 0,
        "worktree_created": False,
        "payload_files_created": 0,
    }
    if doc["expected_success"] != expected_success:
        errors.append("fixture:SUCCESS")
    return errors


def self_test() -> int:
    baseline = synthetic_fixture()
    cases: dict[str, tuple[dict[str, Any], bool]] = {"baseline": (baseline, True)}
    for name, mutate in (
        ("replace_objects", lambda item: item["environment"].__setitem__("GIT_NO_REPLACE_OBJECTS", "0")),
        ("review_binding", lambda item: item["review_binding"].__setitem__("manifest_verified_before_git", False)),
        ("extra_git_command", lambda item: item["command_ids"].append("EXTRA")),
        ("root_symlink", lambda item: item["path_safety"].__setitem__("canonical_root_rejects_symlink", False)),
        ("receipt_not_exclusive", lambda item: item["path_safety"].__setitem__("receipt_open_flags", ["O_WRONLY", "O_CREAT"])),
        ("temporary_order", lambda item: item["path_safety"].__setitem__("temporary_result_created_after_marker", False)),
        ("signal_gap", lambda item: item["finalizer"].__setitem__("catchable_signals", ["SIGINT"])),
        ("signal_setup_gap", lambda item: item["finalizer"].__setitem__("signals_blocked_before_handler_installation", False)),
        ("output_leak", lambda item: item["expected_success"].__setitem__("stdout_bytes_emitted", 1)),
    ):
        mutated = copy.deepcopy(baseline)
        mutate(mutated)
        cases[name] = (mutated, False)
    failures: list[str] = []
    for name, (doc, should_pass) in cases.items():
        passed = not validate_synthetic_fixture(doc)
        if passed is not should_pass:
            failures.append(name)
    print(json.dumps({"result": "PASS" if not failures else "BLOCKED", "cases": len(cases), "failures": failures}, sort_keys=True))
    return 0 if not failures else 1


def _load_json_no_duplicates(path: Path) -> Any:
    def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate JSON key")
            result[key] = value
        return result
    return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=reject_duplicates)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--self-test", action="store_true")
    group.add_argument("--fixture", type=Path)
    group.add_argument("--actual", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    if args.fixture is not None:
        try:
            errors = validate_synthetic_fixture(_load_json_no_duplicates(args.fixture))
        except (OSError, UnicodeError, ValueError, json.JSONDecodeError):
            errors = ["fixture:BLOCKED"]
        print(json.dumps({"result": "PASS_NO_BLOCKER" if not errors else "BLOCKED", "errors": errors}, sort_keys=True))
        return 0 if not errors else 1
    return run_actual()


if __name__ == "__main__":
    raise SystemExit(main())
