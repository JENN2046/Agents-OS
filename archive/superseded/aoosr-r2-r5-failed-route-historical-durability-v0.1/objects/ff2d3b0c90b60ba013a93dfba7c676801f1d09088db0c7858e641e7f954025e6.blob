#!/usr/bin/env python3
"""Deterministically materialize the synthetic R2 runner fixture."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import runpy


RUNNER = runpy.run_path(
    str(Path(__file__).with_name("run-phase-5d-m0d-actual-object-only-source-run-r2.py"))
)


def render() -> bytes:
    return json.dumps(
        RUNNER["synthetic_fixture"](),
        ensure_ascii=True,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("ascii") + b"\n"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    args.output.write_bytes(render())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
